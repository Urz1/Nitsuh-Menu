# -----------------------------------------------------------------------------
# DIGITAL MENU — PRODUCTION ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=https://menu.yourrestaurant.com

# 2. Database (Neon Serverless PostgreSQL / Supabase)
# Neon Serverless Postgres:
DATABASE_URL=postgresql://neondb_owner:password@ep-small-haze-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or Supabase Multi-Tenant PostgreSQL & Realtime (Optional fallback):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Cookieless Analytics (Plausible / Self-Hosted)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=menu.yourrestaurant.com
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# 4. Reliability & Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# 5. Environment
NODE_ENV=production
